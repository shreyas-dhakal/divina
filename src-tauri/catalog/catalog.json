[
  {
    "id": "shadcn-vue",
    "name": "shadcn-vue",
    "framework": "vue",
    "versions": ">=3",
    "install": "pnpm dlx shadcn-vue@latest add",
    "importFrom": "@/components/ui",
    "docs": "https://www.shadcn-vue.com/docs/components",
    "custom": false,
    "components": [
      {
        "name": "Accordion",
        "usage": "<Accordion type=\"single\" collapsible><AccordionItem value=\"item-1\"><AccordionTrigger>Section</AccordionTrigger><AccordionContent>Content</AccordionContent></AccordionItem></Accordion>",
        "thumbnail": "/catalog/shadcn-vue/Accordion.webp"
      },
      {
        "name": "Alert",
        "usage": "<Alert><AlertTitle>Heads up</AlertTitle><AlertDescription>Details here.</AlertDescription></Alert>",
        "thumbnail": "/catalog/shadcn-vue/Alert.webp"
      },
      {
        "name": "Avatar",
        "usage": "<Avatar><AvatarImage src=\"/avatar.png\" alt=\"User\" /><AvatarFallback>JD</AvatarFallback></Avatar>",
        "thumbnail": "/catalog/shadcn-vue/Avatar.webp"
      },
      {
        "name": "Badge",
        "usage": "<Badge>New</Badge>",
        "thumbnail": "/catalog/shadcn-vue/Badge.webp"
      },
      {
        "name": "Button",
        "usage": "<Button>Click me</Button>",
        "thumbnail": "/catalog/shadcn-vue/Button.webp"
      },
      {
        "name": "Card",
        "usage": "<Card><CardHeader><CardTitle>Title</CardTitle><CardDescription>Description</CardDescription></CardHeader><CardContent>Content</CardContent></Card>",
        "thumbnail": "/catalog/shadcn-vue/Card.webp"
      },
      {
        "name": "Checkbox",
        "usage": "<Checkbox id=\"terms\" />",
        "thumbnail": "/catalog/shadcn-vue/Checkbox.webp"
      },
      {
        "name": "Input",
        "usage": "<Input type=\"email\" placeholder=\"Email\" />",
        "thumbnail": "/catalog/shadcn-vue/Input.webp"
      },
      {
        "name": "Label",
        "usage": "<Label for=\"email\">Email</Label>",
        "thumbnail": "/catalog/shadcn-vue/Label.webp"
      },
      {
        "name": "Progress",
        "usage": "<Progress :model-value=\"60\" />",
        "thumbnail": "/catalog/shadcn-vue/Progress.webp"
      },
      {
        "name": "Separator",
        "usage": "<Separator />",
        "thumbnail": "/catalog/shadcn-vue/Separator.webp"
      },
      {
        "name": "Skeleton",
        "usage": "<Skeleton class=\"h-4 w-[250px]\" />",
        "thumbnail": "/catalog/shadcn-vue/Skeleton.webp"
      },
      {
        "name": "Slider",
        "usage": "<Slider :default-value=\"[50]\" :max=\"100\" :step=\"1\" />",
        "thumbnail": "/catalog/shadcn-vue/Slider.webp"
      },
      {
        "name": "Switch",
        "usage": "<Switch id=\"airplane-mode\" />",
        "thumbnail": "/catalog/shadcn-vue/Switch.webp"
      },
      {
        "name": "Tabs",
        "usage": "<Tabs default-value=\"account\"><TabsList><TabsTrigger value=\"account\">Account</TabsTrigger><TabsTrigger value=\"password\">Password</TabsTrigger></TabsList><TabsContent value=\"account\">Account settings</TabsContent><TabsContent value=\"password\">Change password</TabsContent></Tabs>",
        "thumbnail": "/catalog/shadcn-vue/Tabs.webp"
      },
      {
        "name": "Textarea",
        "usage": "<Textarea placeholder=\"Type your message here.\" />",
        "thumbnail": "/catalog/shadcn-vue/Textarea.webp"
      }
    ]
  },
